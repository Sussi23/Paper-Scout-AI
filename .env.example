# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Gemini (required) ---
GEMINI_API_KEY=
# No default on purpose: run `python scripts/list_models.py` and pick one.
GEMINI_MODEL=
# Optional. Empty = model default (recommended for Gemini 3+).
GEMINI_TEMPERATURE=
# Minimum spacing (seconds) between Gemini calls, to avoid 429 on Free Tier.
GEMINI_MIN_INTERVAL_SECONDS=2

# --- OpenAlex (required; free key at https://openalex.org/settings/api) ---
OPENALEX_API_KEY=

# --- Agent limits ---
MAX_SEARCHES=3
MAX_MODEL_STEPS=12
SEARCH_PAGE_SIZE=25
ABSTRACT_CHARS_FOR_MODEL=1200

# --- Server ---
MAX_CONCURRENT_RUNS=1
# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_DIR=logs
RUNS_DIR=runs
CRITERIA_PATH=evaluation/screening_criteria.md
