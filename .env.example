# Sao chép file này thành .env rồi điền giá trị. TUYỆT ĐỐI KHÔNG commit file .env.

# --- Gemini (bắt buộc) ---
GEMINI_API_KEY=
# Cố ý không có giá trị mặc định: chạy `python scripts/list_models.py` rồi chọn một model.
GEMINI_MODEL=
# Tuỳ chọn. Để trống = dùng mặc định của model (khuyến nghị cho Gemini 3 trở lên).
GEMINI_TEMPERATURE=
# Khoảng cách tối thiểu (giây) giữa các lần gọi Gemini, để tránh lỗi 429 ở gói miễn phí.
GEMINI_MIN_INTERVAL_SECONDS=2

# --- OpenAlex (bắt buộc; key miễn phí tại https://openalex.org/settings/api) ---
OPENALEX_API_KEY=

# --- Giới hạn của agent ---
MAX_SEARCHES=3
MAX_MODEL_STEPS=12
SEARCH_PAGE_SIZE=25
ABSTRACT_CHARS_FOR_MODEL=1200

# --- Máy chủ ---
MAX_CONCURRENT_RUNS=1
# Danh sách origin của frontend được phép gọi API (CORS), phân tách bằng dấu phẩy.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_DIR=logs
RUNS_DIR=runs
CRITERIA_PATH=evaluation/screening_criteria.md
